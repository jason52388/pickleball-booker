# ── Booking site credentials ──────────────────────────────────────────────────
CPD_URL=https://anc.apm.activecommunities.com/chicagoparkdistrict/reservation/landing/quick?groupId=2
CPD_USERNAME=your@email.com
CPD_PASSWORD=yourpassword

# ── Booking behaviour ─────────────────────────────────────────────────────────
# Name entered in the "Event name" field when reserving
BOOKING_EVENT_NAME=Pickleball

# Prevent double-booking the same weekend (set to false to disable)
BOOKING_LOCK_ENABLED=true

# Scrape/book without actually submitting (true = safe test mode)
DRY_RUN=false

# Stop just before the payment page and send a screenshot to Telegram
PREVIEW_STOP_BEFORE_PAY=false

# ── Slot filtering ────────────────────────────────────────────────────────────
TARGET_FACILITY=McFetridge
PICKLEBALL_INCLUDE=pickleball
PICKLEBALL_EXCLUDE=ball machine

# Preferred booking window (24-hour values, inclusive)
PREFERRED_START_HOUR=8
PREFERRED_END_HOUR=11

# ── Payment ───────────────────────────────────────────────────────────────────
# CVV is entered automatically on the checkout page
CREDIT_CARD_CVV=123

# ── Telegram notifications ────────────────────────────────────────────────────
# Create a bot via @BotFather, then message the bot and call:
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat ID
TELEGRAM_BOT_TOKEN=123456789:AAF...
TELEGRAM_CHAT_ID=987654321

# ── Email notifications (optional) ───────────────────────────────────────────
# Use a Gmail App Password (Google Account → Security → App Passwords)
# Leave blank to disable email entirely
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
CALENDAR_INVITE_EMAILS=you@example.com,partner@example.com

# ── ISP proxy (optional) ──────────────────────────────────────────────────────
# Routes browser traffic through a residential proxy to avoid bot detection
# Leave blank to connect directly
ISP_PROXY_HOST=
ISP_PROXY_PORT=
ISP_PROXY_USERNAME=
ISP_PROXY_PASSWORD=

# ── Browser ───────────────────────────────────────────────────────────────────
# Always true in Docker; set to false only for local headed debugging
BROWSER_HEADLESS=true

# ── Advanced / rarely changed ─────────────────────────────────────────────────
# CRON_MODE=false
